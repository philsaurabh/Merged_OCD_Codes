<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="styledashboard.css" />
    <title>Dashboard page</title>
  </head>

  <body class="home">
    <div class="">
      <div class="row">
        <div class="col-md-12 col-12 col-lg-12 col-sm-12 float-end">
          <!--<button type="button" class="slide-toggle">Slide Toggle</button> -->

          <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
              <div>
              <a class="title navbar-brand pe-5 text-wrap" href="#"> 
                IITP Centre of Excellence in Cyber Crime Prevention against
                Women and Children- AI based Tools for Women and Children
                Safety</a>
              </div>
            
              <li class="nav-item text-nowrap">
                <a href="/users/logout" class="nav-link" href="#" style="padding-bottom: 20px; color: white;">
                  <i  class="fa-solid fa-arrow-right-from-bracket"></i><h6>Logout</h6></a>
              </li>


              
            </div>
          </nav>
        </div>


        <div class="col-12 col-lg-6 col-md-6 col-sm-12 ng-star-inserted">
          <div class="card" style="height: 17rem; margin-left: 8px; margin-right: 8px;
          margin-top: 5px;">
            <div class="card-header" style="text-align: center;"><h5>Welcome</h5></div>
            <div class="card-body">
              <div class="row">
                <div class="col-4" style="max-width: 27%">
                  <img alt="img" class="img-fluid" src="usericon.png" style="width: 126px;
                  height: 84px;
                  border-radius: 20px;
                  padding-top: 5px;" />
                  <!-- <p> <i class="fa-solid fa-user-check fa-2xl"></i> </p> -->
                </div>
                <div class="col-8">
                  <h2><%= name %></h2>
                  <hr/>
                  <p>
                    <b> Username: </b> abcxyz1404, &nbsp; <br/>
                    <b>Post: </b> Head of the Department<br/>
                    <b>Email: </b> <%= email %> <br/>
                  </p>
                  <table>
                    <tr>
                      <td></td>
                    </tr>
                  </table>
               </div>
              </div>
            </div>
          </div>
        </div> 
    
        <div class="col-12 col-lg-6 col-md-6 col-sm-12 ng-star-inserted">
        <div class="card" style="margin-right: 8px; margin-left: 8px;
        margin-top: 5px;">
          <div class="card-body" style="height: 17rem; padding-top: 18px;">
             
              <table class="table display-table col-8 col-lg-4 col-md-4 col-sm-12" style="margin-top: 5px;">
                <tbody>
                
                  <div style="background-color: rgb(188, 240, 188);
                  height: 39px; text-align: center; padding-top: 6px; font-weight: 600;">
                   Scuffle <i class="fa-solid fa-hand-back-fist"></i>
                  </div>
                
                  <div style="background-color: rgb(198, 228, 245);
                  height: 39px; text-align: center; padding-top: 6px; font-weight: 600;">
                    Weapon <i class="fa-solid fa-gun"></i>
                  </div>
                 

                  <div style="background-color: rgb(243, 192, 245);
                  height: 39px; text-align: center; padding-top: 6px; font-weight: 600;">
                    Vehicle <i class="fa-solid fa-car"></i>
                  </div>
                  
                  <div style="background-color: rgb(240, 222, 188);
                  height: 39px; text-align: center; padding-top: 6px; font-weight: 600;">
                    Faces <i class="fa-solid fa-user-large"></i>
                  </div>

                  <div style="background-color: rgb(226, 240, 188);
                  height: 39px; text-align: center; padding-top: 6px; font-weight: 600;">
                    Full Body <i class="fa-solid fa-child"></i>
                  </div>

                  <div style="background-color: rgb(225, 188, 240);
                  height: 39px; text-align: center; padding-top: 6px; font-weight: 600;">
                     Obscene <i class="fa-solid fa-face-frown"></i>
                  </div>
                
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div> 
      </div>


        <!-- <div class="card" style="width: 18rem;">
          <div class="card-body"> -->
          
            
       
       

      </div>
      </div>
    
    
    <script src="https://kit.fontawesome.com/7a3e156349.js" crossorigin="anonymous"></script>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
      crossorigin="anonymous"
    ></script>
    <script
      src="https://kit.fontawesome.com/5067d75733.js"
      crossorigin="anonymous"
    ></script>
  </body>
</html>

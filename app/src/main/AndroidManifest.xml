<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.iitp.obsencemediadetector">

    <uses-permission
        android:name="android.permission.READ_PRIVILEGED_PHONE_STATE"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <application
        android:name=".BaseApplication"
        android:allowBackup="true"
        android:icon="@mipmap/app_logo"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/app_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.ObsenceMediaDetector">

        <meta-data
            android:name="DATABASE"
            android:value="sugar_example.db" />
        <meta-data
            android:name="VERSION"
            android:value="2" />
        <meta-data
            android:name="QUERY_LOG"
            android:value="true" />
        <meta-data
            android:name="DOMAIN_PACKAGE_NAME"
            android:value="com.example" />

        <activity
            android:name=".Testing.GalleryHiddenTesting"
            android:exported="false" />
        <activity
            android:name=".Images.HiddenImages.HiddenImageActivity"
            android:exported="false" />
        <activity
            android:name=".Videos.VideoChecker.CheckVideoGalleryFolders"
            android:exported="false" />
        <activity
            android:name=".Videos.VideoChecker.CheckFolderVideos"
            android:exported="false" />
        <activity
            android:name=".Videos.FolderVideos.ScanFolderVideos"
            android:exported="false" />
        <activity
            android:name=".Videos.FolderVideos.VideoGalleryFolders"
            android:exported="false" />
        <activity
            android:name=".Images.SingleImageScan.SingleImageScan"
            android:exported="false" />
        <activity
            android:name=".Images.ImageFolderScan.ScanFolderImages"
            android:exported="false" />
        <activity
            android:name=".Videos.SingleVideos.SingleVideoScanning"
            android:exported="false" />
        <activity
            android:name=".Images.ImageFolderScan.ImageGalleryFolders"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:exported="true"/>

        <activity
            android:name=".SplashActivity"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>